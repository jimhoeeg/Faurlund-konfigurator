# Skråfoto-integrationen. Kopiér til .env og udfyld.
# Uden VITE_STAC_TOKEN falder modulet automatisk tilbage til billed-upload.

# Token fra https://dataforsyningen.dk/ — dækker både skråfoto og adressesøgning.
# Bemærk: dette token ender i frontend-koden og er synligt for besøgende.
# Sådan er tjenesten designet, men det er knyttet til jeres konto.
VITE_STAC_TOKEN=

# Højdemodellen (DHM). Kræves KUN for at kunne måle arealer op.
# Oprettes separat på https://datafordeler.dk/dataoversigt/danmarks-hoejdemodel-dhm/koter/
#
# ANBEFALET: lad kaldet gå gennem jeres egen server, så legitimationen bliver
# på bagsiden. Sæt VITE_DHM_PROXY_URL og lad de to nedenstående stå tomme.
VITE_DHM_PROXY_URL=

# Kun hvis I bevidst accepterer, at en service-bruger ligger i klientkoden:
VITE_DHM_USER=
VITE_DHM_PASS=
